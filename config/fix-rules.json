{
  "_catatan": "Aturan perbaikan prompt, disusun dari kasus gagal/berhasil di serial Suami Kurir, Anak yang Dibuang, dan Suami Pelit. Tangga dijalankan berurutan: setiap kali scene gagal, level naik satu.",
  "ladder": [
    {
      "level": 0,
      "name": "Prompt asli",
      "desc": "Strip storyboard sebagai start frame, prompt lengkap."
    },
    {
      "level": 1,
      "name": "Haluskan kata",
      "desc": "Ganti kata rawan (lempar, marah, uang, kamar tidur, dll) dengan versi netral; bersihkan daftar Avoid dari kata seperti violence/weapons."
    },
    {
      "level": 2,
      "name": "Foto tunggal + prompt ringkas",
      "desc": "Start frame diganti foto shot 1 saja (bukan strip kolase), instruksi storyboard dihapus, daftar Avoid dipendekkan."
    },
    {
      "level": 3,
      "name": "Haluskan dialog",
      "desc": "Kalimat dialog yang menyebut uang/nominal/pecat/cerai/hinaan dibuang dari prompt (dicatat untuk VO)."
    },
    {
      "level": 4,
      "name": "Tanpa dialog",
      "desc": "Semua dialog dihapus, audio hanya ambience + musik. Dialog dicatat untuk VO saat penggabungan."
    },
    {
      "level": 5,
      "name": "Cek manual",
      "desc": "Semua tangga habis. Scene ditandai untuk kamu periksa."
    }
  ],
